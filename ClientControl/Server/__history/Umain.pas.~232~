procedure TMainForm.RestartAllButtonClick(Sender: TObject);
var
  i: Integer;
  NetData: TCommandData;
  SelectedIndex: Integer;
  CommandData: TCommandData;
  ipaddress: string;
  indexBox: byte;
  command: byte;
begin

  SelectedIndex := ClientConnectedListBox.ItemIndex;

  indexBox := ClientConnectedListBox.Items.Count;

  for i := 0 to indexBox - 1 do
  begin
    SelectedIndex := i;

    if SelectedIndex > -1 then
    begin
      ipaddress := server.Clients[SelectedIndex].ConnectedIP;
      command := 5;
      CommandData.command := command;
      server.SendDataToIPAddress(CommandID, @CommandData, ipaddress);
    end;
  end;
end;

