  System.Classes, Vcl.Graphics, uLibSetting,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls, uExecuter,
  uTCPClient, ShellApi, Vcl.Imaging.jpeg, Winapi.TlHelp32, Vcl.Imaging.pngimage;

type
