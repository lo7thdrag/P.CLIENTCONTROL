procedure TMainForm.UpdateSystemClientState;
var
  i : Integer;
  li : TListItem;

begin
  for i := 0 to lvSystem.Items.Count-1 do
  begin
    li := lvSystem.Items[i];

    if server.getClientState(li.SubItems[0]) then
    begin
      li.StateIndex := 1;
      li.SubItems[1] := 'Connected'
    end
    else
    begin
      li.StateIndex := 0;
      li.SubItems[1] := 'Disconnected'
    end;
  end;
end;

